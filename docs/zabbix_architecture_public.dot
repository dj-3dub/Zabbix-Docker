digraph ZabbixDocker {
  rankdir=LR;
  graph [fontsize=10, labelloc="t", pad=0.3, nodesep=0.4, ranksep=0.7];
  node  [shape=rounded, style=filled, fillcolor="#f7f7f7", fontname="Helvetica"];
  edge  [color="#888888"];

  subgraph cluster_net {
    label="Docker Network";
    color="#dddddd";

    Traefik [label="Caddy/Traefik\n(optional)", shape=box, fillcolor="#eef7ff"];
    ZabbixWeb [label="Zabbix Web\n(Nginx + PHP)", shape=box];
    ZabbixSrv [label="Zabbix Server", shape=box];
    Postgres [label="PostgreSQL\n(state)", shape=box, fillcolor="#fff7ee"];
    Proxy [label="Zabbix Proxy\n(optional)", shape=box];
    Agent [label="Zabbix Agent\n(host + services)", shape=box];

    Traefik -> ZabbixWeb [label="HTTPS"];
    ZabbixWeb -> ZabbixSrv [label="API"];
    ZabbixSrv -> Postgres  [label="SQL", dir=both];
    Proxy -> ZabbixSrv     [label="buffered metrics"];
    Agent -> ZabbixSrv     [label="items/active checks"];
  }

  User [label="User Browser", shape=oval, fillcolor="#e8ffe8"];
  DNS [label="monitor.lab\n(local DNS/hosts)", shape=oval, fillcolor="#e8ffe8"];
  Authentik [label="Authentik IdP\n(optional SSO)", shape=box, fillcolor="#fff0f5"];

  User -> DNS [style=dashed, label="resolve"];
  DNS  -> Traefik [label="https://monitor.lab"];
  User -> ZabbixWeb [label="http(s):port", style=dashed]; // direct mode (no proxy)
  ZabbixWeb -> Authentik [label="SAML / redirect", style=bold];
  Traefik -> Authentik [label="forward-auth", style=dashed];
}