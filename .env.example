# Zabbix test stack env
TZ=America/Chicago

# Database credentials (change for anything beyond a throwaway test)
DB_USER=zabbix
DB_PASSWORD=change-me
DB_NAME=zabbix

# Web UI host port (container listens on 8080)
WEB_PORT=8180

# Zabbix server port
ZBX_PORT=10051

# Zabbix agent hostname (how it appears in UI for this host)
ZBX_AGENT_HOSTNAME=zabbix-host
