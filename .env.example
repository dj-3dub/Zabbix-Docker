# --------------------------------------------------
# Zabbix Docker Monitoring Stack
# Example environment configuration
# Copy to .env and customize as needed
# --------------------------------------------------

# Timezone
TZ=America/Chicago

# PostgreSQL Database
DB_USER=zabbix
DB_PASSWORD=change-me
DB_NAME=zabbix

# Zabbix Web UI
# Access: http://localhost:${WEB_PORT}
WEB_PORT=8180

# Zabbix Server Port
ZBX_PORT=10051

# Agent hostname displayed in Zabbix
ZBX_AGENT_HOSTNAME=zabbix-host
